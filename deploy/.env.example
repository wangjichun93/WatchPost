# =====================================================================
# 望哨 WATCHPOST · Docker Compose 环境变量样例
# 复制为 .env 并填入真实值: cp .env.example .env
# ⚠️ .env 含密钥, 切勿提交版本库 (已在 .gitignore 排除)
# =====================================================================

# ---- 数据库口令 ----
WP_DB_PASSWORD=change-me-db-password

# ---- 安全密钥 (必填, 生产用 KMS/密管注入) ----
# JWT 签名密钥, 必须 >=32 字节 (256 bit)
WP_JWT_SECRET=please-change-this-to-a-random-32byte-minimum-secret-key
# 凭据 AES-256-GCM 加密主密钥 (丢失则已存凭据无法解密)
WP_CRYPTO_KEY=please-change-this-crypto-master-key

# ---- 引导管理员 (首次启动创建, 请首登改密) ----
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin123

# ---- 存储/队列 (v1 单机默认) ----
# 时序存储: jpa(默认, PostgreSQL落盘) | iotdb(生产可插拔)
WP_STORE_TYPE=jpa
# 指标队列: memory(默认单进程) | redis | kafka(集群)
WP_QUEUE_TYPE=memory

# ---- 邮件链接基址 (告警详情/静默链接) ----
WP_MAIL_BASE_URL=http://localhost:1157
