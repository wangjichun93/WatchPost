# =====================================================================
# 望哨 WATCHPOST · 前端运行镜像 (瘦镜像: 直接 COPY 预构建 dist, 不在服务器跑 npm)
# 构建上下文 = 工程根目录; dist 置于 web-app/dist
# 基础镜像 nginx:1.27-alpine 已存在于服务器本地
# =====================================================================
FROM nginx:1.27-alpine

# 复制预构建的 SPA 产物
COPY web-app/dist /usr/share/nginx/html
# 复制 nginx 配置 (SPA 回退 + /api 反代 + /ws WebSocket 升级)
COPY deploy/server/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
# 健康检查用 127.0.0.1: nginx 仅监听 IPv4 0.0.0.0:80, 而 alpine 内 localhost 优先解析 IPv6 ::1 会拒连
HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=10s \
    CMD wget -qO- http://127.0.0.1/nginx-health || exit 1
