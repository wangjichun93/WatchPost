<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.watchpost</groupId>
    <artifactId>watchpost</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>watchpost</name>
    <description>望哨 WATCHPOST - 无 Agent 实时监控系统</description>

    <modules>
        <module>watchpost-common</module>
        <module>watchpost-warehouse</module>
        <module>watchpost-collector</module>
        <module>watchpost-alerter</module>
        <module>watchpost-manager</module>
        <module>watchpost-startup</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 协议采集库 -->
        <mina-sshd.version>2.20.1</mina-sshd.version>
        <okhttp.version>4.12.0</okhttp.version>
        <snmp4j.version>3.13.2</snmp4j.version>
        <!-- 规则/调度/工具 -->
        <commons-jexl3.version>3.3</commons-jexl3.version>
        <cron-utils.version>9.2.1</cron-utils.version>
        <json-path.version>2.9.0</json-path.version>
        <!-- 安全 -->
        <jjwt.version>0.12.6</jjwt.version>
        <!-- API 文档 -->
        <springdoc.version>2.8.17</springdoc.version>
        <!-- 数据库驱动 (ojdbc8 固定, 兼容 Oracle 12.1) -->
        <ojdbc8.version>19.33.0.0</ojdbc8.version>
        <!-- 时序库 (默认 IoTDB, 可插拔) -->
        <iotdb-session.version>1.3.7</iotdb-session.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.watchpost</groupId>
                <artifactId>watchpost-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.watchpost</groupId>
                <artifactId>watchpost-warehouse</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.watchpost</groupId>
                <artifactId>watchpost-collector</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.watchpost</groupId>
                <artifactId>watchpost-alerter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.watchpost</groupId>
                <artifactId>watchpost-manager</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 协议采集 -->
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-core</artifactId>
                <version>${mina-sshd.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>org.snmp4j</groupId>
                <artifactId>snmp4j</artifactId>
                <version>${snmp4j.version}</version>
            </dependency>

            <!-- 规则表达式 / 调度 / 工具 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-jexl3</artifactId>
                <version>${commons-jexl3.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cronutils</groupId>
                <artifactId>cron-utils</artifactId>
                <version>${cron-utils.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jayway.jsonpath</groupId>
                <artifactId>json-path</artifactId>
                <version>${json-path.version}</version>
            </dependency>

            <!-- 安全 JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- API 文档 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Oracle 驱动: 固定 ojdbc8 (兼容 12.1, ojdbc11 不兼容) -->
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc8</artifactId>
                <version>${ojdbc8.version}</version>
            </dependency>

            <!-- 时序库 (可插拔, 默认 IoTDB) -->
            <dependency>
                <groupId>org.apache.iotdb</groupId>
                <artifactId>iotdb-session</artifactId>
                <version>${iotdb-session.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
